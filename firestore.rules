rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Primary admin identified from user metadata
      return isVerified() && (
        request.auth.token.email == 'bdalzyzalamam744@gmail.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Categories ---
    match /categories/{categoryId} {
      // Public menu needs to read categories
      allow read: if true;
      
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      
      allow update: if isAdmin() && isValidCategory(incoming());
      
      allow delete: if isAdmin();

      function isValidCategory(data) {
        return data.keys().hasAll(['name_ar', 'name_en', 'count']) 
          && data.keys().size() == 3
          && data.name_ar is string && data.name_ar.size() > 0 && data.name_ar.size() < 100
          && data.name_en is string && data.name_en.size() > 0 && data.name_en.size() < 100
          && data.count is number;
      }
    }

    // --- Products ---
    match /products/{productId} {
      // Public menu needs to read products
      allow read: if true;
      
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      
      allow update: if isAdmin() && isValidProduct(incoming());
      
      allow delete: if isAdmin();

      function isValidProduct(data) {
        return data.keys().hasAll(['name_ar', 'categoryId', 'price', 'stock', 'status', 'updatedAt'])
          && data.keys().size() == 6
          && data.name_ar is string && data.name_ar.size() > 0 && data.name_ar.size() < 150
          && data.categoryId is string && exists(/databases/$(database)/documents/categories/$(data.categoryId))
          && data.price is number && data.price >= 0
          && data.stock is number && data.stock >= 0
          && (data.status == 'نشط' || data.status == 'نفذ' || data.status == 'منخفض')
          && data.updatedAt == request.time;
      }
    }
  }
}
