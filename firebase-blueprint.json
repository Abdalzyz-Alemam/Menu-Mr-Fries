{
  "entities": {
    "Category": {
      "title": "Category",
      "description": "Menu category",
      "type": "object",
      "properties": {
        "name_ar": { "type": "string" },
        "name_en": { "type": "string" }
      },
      "required": ["name_ar", "name_en"]
    },
    "Product": {
      "title": "Product",
      "description": "Menu item",
      "type": "object",
      "properties": {
        "name_product_ar": { "type": "string" },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name_product_ar", "categoryId", "price"]
    }
  },
  "firestore": {
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of menu categories"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of menu items"
    }
  }
}
